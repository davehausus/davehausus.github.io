---
import Layout from "../layouts/Layout.astro";
import BlogPost from "../components/BlogPost.astro";
const base = import.meta.env.BASE_URL;

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "The Workshop";
---

<Layout pageTitle={pageTitle}>
  <h2>My Astro Site</h2>
  <p>
    I spend my time studying how things move and why that movement matters. I
    write to share what I learn and make digital products feel better.
  </p>
  <ul>
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
  </ul>
</Layout>
