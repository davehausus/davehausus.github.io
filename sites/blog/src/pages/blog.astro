---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogPost from "../components/BlogPost.astro";
const base = import.meta.env.BASE_URL;

const pageTitle = "The Workshop";
const allPosts = await getCollection("blog");
---

<Layout pageTitle={pageTitle}>
  <h2>My Astro Site</h2>
  <p>
    I spend my time studying how things move and why that movement matters. I
    write to share what I learn and make digital products feel better.
  </p>
  <ul>
    {allPosts.map((post: any) => <BlogPost url={`${base}posts/${post.id}/`} title={post.data.title} />)}
  </ul>
</Layout>
