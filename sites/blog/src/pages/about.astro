---
import Layout from '~/layouts/PageLayout.astro';
import Hero3 from '~/components/widgets/Hero3.astro';
import Features3 from '~/components/widgets/Features3.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

<Hero3
  tagline=""
>
  <Fragment slot="title">
    Designing digital products with <br />
    <span class="text-accent dark:text-(--aw-color-title)">clarity, motion, and intention.</span>
  </Fragment>

  <Fragment slot="subtitle">
    <br /><br />
    I'm David de Jesús, a Senior Product Designer based in Guadalajara, Mexico. I've been drawn to technology since my early teens, always curious about gadgets, computers, and what you could create with them.

    <br /><br />
    I didn't know Graphic Design was the path I wanted to take until a close friend pointed out that the presentations and school projects I spent so much time designing were already a form of it. I followed that advice into university, where I discovered web design and Macromedia Flash. Flash brought together everything I was looking for: design, technology, animation, and interaction. It was the moment I realized I wanted to create digital experiences, from websites and apps to animations and everything in between.

    <br /><br />
    Years later, tools like Lottie and Rive rekindled that same fascination with interactive motion. Today, I work across product design, interaction, UI systems, and motion, using animation to communicate behavior, feedback, and state in digital products.

    <br /><br />
    I'm always looking for inspiration in unexpected places, from video games and movies to the visuals artists use during live performances. I enjoy exploring how movement works, then bringing those ideas into interfaces in ways that are useful, expressive, and intentional.
  </Fragment>
</Hero3>


<Features3
  title="What I Work On"
  subtitle="I bring product thinking, interface design, and motion together to create digital experiences that are clear, responsive, and built to scale."
  columns={3}
  isBeforeContent={true}
  items={[
    {
      title: 'Product Design',
      description:
        'Designing clear, intuitive experiences for web and mobile products, from early concepts and flows to polished interfaces.',
      icon: 'tabler:devices',
    },
    {
      title: 'UI & Interaction',
      description:
        'Designing interfaces, transitions, and feedback that help people understand what is happening and what they can do next.',
      icon: 'tabler:click',
    },
    {
      title: 'Rive & Motion',
      description:
        'Building interactive Rive animations and state machines for behavior-rich interfaces, prototypes, and product experiences.',
      icon: 'tabler:ease-in-out-control-points',
    },
    {
      title: 'Motion Systems',
      description:
        'Creating reusable motion patterns that bring consistency to transitions, feedback, and interaction across a product.',
      icon: 'tabler:transform',
    },
    {
      title: 'Interactive Prototypes',
      description:
        'Prototyping complex product flows and interactions to make ideas tangible, test behavior, and align teams before development.',
      icon: 'tabler:arrow-guide',
    },
    {
      title: 'Design Systems',
      description:
        'Connecting UI, interaction, and motion decisions into scalable systems that work consistently across platforms and devices.',
      icon: 'tabler:components',
    },
  ]}
/>
</Layout>
