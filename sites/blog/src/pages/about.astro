---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;

const pageTitle = "About Me";

const identity = {
  firstName: "David",
  country: "Mexico",
  occupation: "Product Designer",
  hobbies: ["photography", "birdwatching", "baseball"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Writing Docs"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<Layout pageTitle={pageTitle}>
  <h2>... and my new Astro site!</h2>

  <p>
    Since 2009, I’ve worked across web, mobile, and large-screen experiences,
    helping teams design clear, responsive, and intuitive products. My
    background sits at the intersection of product design, interface design, and
    motion systems, where motion is treated as a functional layer of the user
    experience rather than visual decoration.
  </p>

  <p>Here are a few facts about me:</p>
  <ul>
    <li>My name is {identity.firstName}.</li>
    <li>I live in {identity.country} and I work as a {identity.occupation}.</li>
    {
      identity.hobbies.length >= 2 && (
        <li>
          Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}
        </li>
      )
    }
  </ul>
  <p>My skills are:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  {happy && <p>I am happy to be learning Astro!</p>}

  {finished && <p>I finished this tutorial!</p>}

  {
    goal === 3 ? (
      <p>My goal is to finish in 3 days.</p>
    ) : (
      <p>My goal is not 3 days.</p>
    )
  }
</Layout>

<style is:global define:vars={{ skillColor, fontWeight, textCase }}>
  .skill {
    color: var(--skillColor);
    font-weight: var(--fontWeight);
    text-transform: var(--textCase);
  }
</style>
