---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Collaborate" />

  <ContactUs
    id="form"
    title=""
    subtitle="Have a project in mind? Looking for a product designer? Want to collaborate, share an idea, or just say hello?
<br /><br />
Drop me a message. I'd love to hear what you're working on."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your name *',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Your e-mail *',
        required: true,
      },
      {
        type: 'text',
        name: 'subject',
        label: 'Subject',
      },
    ]}
    textarea={{
      label: 'Your message *',
      name: 'message',
      required: true,
    }}
    disclaimer={{
      label:
        "I'll only use the information you provide to respond to your message. See my Privacy Notice for details.",
    }}
    button="Send message"
    action="https://formspree.io/f/mqevbakz"
    redirectTo="https://daviddejesus.me/about"

    description=""
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="What's on your mind?"
    items={[
      {
        title: "Hiring for a role?",
        description: "Looking for a Senior Product Designer with a strong motion and interaction background? I'd be happy to hear about the opportunity.",
      },
      {
        title: "Have a project?",
        description:
          "Tell me what you're building, where you're at, and what you need help with. I'll take it from there.",
      },
      {
        title: "Want to collaborate?",
        description: "Have an idea, a design challenge, or something interesting you'd like to explore together? Let's start a conversation.",
      },
      {
        title: 'Email',
        description: 'contact@support.com',
        icon: 'tabler:mail',
      },
      {
        title: 'LinkedIn',
        description: 'linkedin.com/in/david-d-jesus',
        icon: 'tabler:brand-linkedin',
      },
      {
        title: 'Location',
        description: '1234 Lorem Ipsum St, 12345, Miami, EEUU',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
