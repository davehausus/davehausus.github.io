---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
  tagType?: string;
  categoryType?: string;
  isTagEnabled?: boolean;
  isLinkEnabled?: boolean;
}

const { posts, tagType, categoryType, isTagEnabled, isLinkEnabled } = Astro.props;
---

<ul>
  {
    posts.map((post) => (
      <li class="mb-12 md:mb-20">
        <Item post={post} tagType={tagType} categoryType={categoryType} isTagEnabled={isTagEnabled} isLinkEnabled={isLinkEnabled} />
      </li>
    ))
  }
</ul>
