<div class="progress-scroll-container" aria-hidden="true">
  <div id="progress-scroll"></div>
</div>

<style>
  .progress-scroll-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 100;
    pointer-events: none;
  }
  #progress-scroll {
    height: 100%;
    width: 0;
    background: var(--aw-color-primary, #3b82f6);
  }
</style>

<script>
  const target = document.querySelector<HTMLElement>('[data-progress-target]');
  const bar = document.getElementById('progress-scroll');
  let ticking = false;

  const update = () => {
    ticking = false;
    if (!target || !bar) return;

    const rect = target.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const scrolled = -rect.top;

    let pct: number;
    if (total > 0) {
      pct = (scrolled / total) * 100;
    } else {
      pct = rect.bottom <= window.innerHeight ? 100 : 0;
    }

    bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
  };

  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', update);
  window.addEventListener('load', update);

  // Case studies are image-heavy: recalculate whenever the content's height changes
  if (target) new ResizeObserver(update).observe(target);

  update();
</script>