---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '', action, redirectTo } = Astro.props;
---

{/*
  `action` set: fetch-based AJAX submit to Formspree (or any endpoint that
  accepts a POST FormData + Accept: application/json), matching the old
  static site's inline <script>. `method="POST"` + the real `action` are
  still on the <form> itself too, so it degrades to a normal POST-and-redirect
  if JS fails to load — the old version had neither, so a no-JS visitor got
  a dead button.
  `action` unset: form renders exactly as before, no wiring at all.
*/}
<form id="contact-form" action={action} method={action ? 'POST' : undefined} data-redirect-to={redirectTo}>
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required = false }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                required={required}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          required={textarea.required ?? false}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    action && (
      <Fragment>
        {/* Formspree's own honeypot field: bots that fill every input get silently dropped server-side. */}
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        {/* Native (no-JS) fallback: Formspree redirects here itself after a plain POST. Overridden client-side below when JS runs. */}
        {redirectTo && <input type="hidden" name="_next" value={redirectTo} />}
      </Fragment>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }

  {
    action && (
      <Fragment>
        <div
          id="contact-form-success"
          class="hidden mt-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-900/50 dark:bg-green-900/20 dark:text-green-300"
          role="alert"
        >
          All good! Your message made it through and is now doing a little victory animation on my end.
        </div>
        <div
          id="contact-form-error"
          class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-300"
          role="alert"
        >
          Hmm, that glitched. The form hit a snag mid-motion. Refresh and give it another go.
        </div>
      </Fragment>
    )
  }
</form>

<script>
  const form = document.getElementById('contact-form');

  if (form instanceof HTMLFormElement && form.getAttribute('action')) {
    const successEl = document.getElementById('contact-form-success');
    const errorEl = document.getElementById('contact-form-error');
    const redirectTo = form.dataset.redirectTo;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      successEl?.classList.add('hidden');
      errorEl?.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          if (redirectTo) {
            window.location.href = redirectTo;
          } else {
            form.reset();
            successEl?.classList.remove('hidden');
          }
        } else {
          errorEl?.classList.remove('hidden');
        }
      } catch {
        errorEl?.classList.remove('hidden');
      }
    });
  }
</script>